# 开发阶段
FROM node:22-bookworm-slim AS development

WORKDIR /app

ARG VITE_API_URL
ARG VITE_CONTACT_EMAIL=3405351711@qq.com
ARG VITE_OPERATOR_NAME=Yang
ARG VITE_OPERATOR_ADDRESS=天津科技大学
ARG VITE_OPERATOR_CITY=天津
ARG VITE_OPERATOR_COUNTRY=中国
ARG VITE_OPERATOR_PHONE=+86 18340012138
ARG VERSION=0.0.0
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG CHANNEL=local
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_CONTACT_EMAIL=$VITE_CONTACT_EMAIL
ENV VITE_OPERATOR_NAME=$VITE_OPERATOR_NAME
ENV VITE_OPERATOR_ADDRESS=$VITE_OPERATOR_ADDRESS
ENV VITE_OPERATOR_CITY=$VITE_OPERATOR_CITY
ENV VITE_OPERATOR_COUNTRY=$VITE_OPERATOR_COUNTRY
ENV VITE_OPERATOR_PHONE=$VITE_OPERATOR_PHONE
ENV APP_VERSION=$VERSION
ENV APP_GIT_SHA=$GIT_SHA
ENV APP_BUILD_TIME=$BUILD_TIME
ENV APP_CHANNEL=$CHANNEL

COPY ./frontend/package*.json ./
RUN npm ci

COPY ./frontend .

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--port", "3000"]

# 构建阶段
FROM node:22-bookworm-slim AS builder

WORKDIR /app

ARG VITE_API_URL
ARG VITE_CONTACT_EMAIL=3405351711@qq.com
ARG VITE_OPERATOR_NAME=Yang
ARG VITE_OPERATOR_ADDRESS=天津科技大学
ARG VITE_OPERATOR_CITY=天津
ARG VITE_OPERATOR_COUNTRY=中国
ARG VITE_OPERATOR_PHONE=+86 18340012138
ARG FRONTEND_BUILD_SCRIPT=build
ARG NODE_OPTIONS
ARG VERSION=0.0.0
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG CHANNEL=local
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_CONTACT_EMAIL=$VITE_CONTACT_EMAIL
ENV VITE_OPERATOR_NAME=$VITE_OPERATOR_NAME
ENV VITE_OPERATOR_ADDRESS=$VITE_OPERATOR_ADDRESS
ENV VITE_OPERATOR_CITY=$VITE_OPERATOR_CITY
ENV VITE_OPERATOR_COUNTRY=$VITE_OPERATOR_COUNTRY
ENV VITE_OPERATOR_PHONE=$VITE_OPERATOR_PHONE
ENV APP_VERSION=$VERSION
ENV APP_GIT_SHA=$GIT_SHA
ENV APP_BUILD_TIME=$BUILD_TIME
ENV APP_CHANNEL=$CHANNEL

COPY ./frontend/package*.json ./
RUN npm ci

COPY ./frontend .
RUN npm run ${FRONTEND_BUILD_SCRIPT}

# 服务阶段
FROM nginx:alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html

RUN echo 'server { \
  listen 3000; \
  root /usr/share/nginx/html; \
  index index.html; \
  \
  # Service Worker——必须始终重新验证 \
  location /sw.js { \
    add_header Cache-Control "no-cache"; \
    try_files $uri =404; \
  } \
  \
  # 构建版本元数据——必须始终重新验证 \
  location = /version.json { \
    add_header Cache-Control "no-cache"; \
    add_header Content-Type "application/json"; \
    try_files $uri =404; \
  } \
  \
  # Web App Manifest——必须始终重新验证 \
  location ~* \.webmanifest$ { \
    add_header Cache-Control "no-cache"; \
    default_type application/manifest+json; \
    try_files $uri =404; \
  } \
  \
  # Workbox 运行时分块 \
  location /workbox- { \
    add_header Cache-Control "no-cache"; \
    try_files $uri =404; \
  } \
  \
  # Vite 哈希资源——使用不可变的长期缓存 \
  location /assets/ { \
    add_header Cache-Control "public, max-age=31536000, immutable"; \
    try_files $uri =404; \
  } \
  \
  # SPA 回退 \
  location / { try_files $uri $uri/ /index.html; } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
