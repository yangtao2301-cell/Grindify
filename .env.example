# Docker Compose 变量
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=grindifydb
POSTGRES_PORT=5432
BACKEND_PORT=1337
FRONTEND_PORT=3000
ADMINPANEL_PORT=3001

## BACKEND ##
# 下面的后端数据库变量引用上面的 Docker Compose 变量，避免重复配置
DATABASE_HOST=postgres
DATABASE_PORT=${POSTGRES_PORT}
DATABASE_USER=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
DATABASE_NAME=${POSTGRES_DB}
# 仅用于本地开发：在全新的数据库中创建当前结构。
# 生产环境或由迁移脚本管理的数据库不要启用此项。
DATABASE_SYNCHRONIZE=false
JWT_SECRET=change-me

# 应用默认值（仅应用于新注册用户）
# true/false（也接受 1/0、yes/no、on/off）
DEFAULT_SHOW_RPE=true

## FRONTEND ##
VITE_API_URL=http://localhost:1337/v1

# 在服务条款、隐私政策和法律声明中显示的运营者联系方式
VITE_CONTACT_EMAIL=3405351711@qq.com
VITE_OPERATOR_PHONE=+86 18340012138

# 法律声明/网站信息（显示在法律声明对话框中）
VITE_OPERATOR_NAME=Yang
VITE_OPERATOR_ADDRESS=天津科技大学
VITE_OPERATOR_CITY=天津
VITE_OPERATOR_COUNTRY=中国

# Vite 开发服务器允许的主机列表（用逗号分隔）
VITE_ALLOWED_HOSTS=localhost

# 后端 CORS 允许的来源列表（用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# 身份验证 Cookie 选项（由 AuthExceptionsFilter 使用）
AUTH_COOKIE_DOMAIN= # e.g. leave blank for localhost
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

# GitHub OAuth——留空可禁用 GitHub 登录
# 在 https://github.com/settings/developers 创建 OAuth App
# 将回调 URL 设置为：http://your-backend/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth——留空可禁用 Google 登录
# 在 https://console.cloud.google.com/apis/credentials 创建 OAuth 2.0 客户端
# 将重定向 URI 设置为：http://your-backend/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 后端公开 URL（用作 OAuth 回调地址的基础 URL）
BACKEND_URL=http://localhost:1337

# 设置页面版本历史对话框使用的 Gitee Releases 代理。
# owner/repo 留空可禁用此功能。
GITEE_RELEASES_OWNER=yang_taoo
GITEE_RELEASES_REPO=grindify
GITEE_RELEASES_TOKEN=

# 邮件服务（Resend）——在 resend.com 获取 API 密钥
# 将 REQUIRE_EMAIL_VERIFICATION=true 设置为登录前必须验证邮箱。
# 为 false（默认值）时，用户注册后会自动验证（不需要发送邮件）。
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
FRONTEND_URL=http://localhost:3000
